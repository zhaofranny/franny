# Server only. Do not commit real values. Never enter API keys in a browser widget.
LLM_PROVIDER=deepseek
APP_PASSWORD=
DATABASE_PATH=data/franny.db
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2200

# Configure ONE official provider initially. A Codex/ChatGPT subscription does not pay for these APIs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# Must match the region where DASHSCOPE_API_KEY was issued.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local, downloaded model: no per-call API billing, but hardware and model download are required.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
# CJK_FONT_PATH=/path/to/chinese-font.ttf
